{
	"info": {
		"_postman_id": "f5acbc7d-01d6-478e-9bc4-635269d7189f",
		"name": "securing-microservices-using-jwt",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
